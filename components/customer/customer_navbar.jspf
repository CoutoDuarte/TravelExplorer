        <a class="public-navbar__brand" href="${pageContext.request.contextPath}/index.jsp?page=customer-dashboard" aria-label="Ir para a dashboard do cliente">
            <span class="public-navbar__brand-mark">TE</span>
            <span class="public-navbar__brand-text">TravelExplorer</span>
        </a>

        <div class="public-navbar__actions">
            <span class="text-muted customer-navbar-note">Área de cliente</span>
            <a class="btn btn-ghost customer-navbar__link" data-customer-nav-page="customer-dashboard" href="${pageContext.request.contextPath}/index.jsp?page=customer-dashboard">Dashboard</a>
            <a class="btn btn-ghost customer-navbar__link" data-customer-nav-page="offers" href="${pageContext.request.contextPath}/index.jsp?page=offers">Explorar ofertas</a>
            <a class="btn btn-secondary customer-navbar__link" data-customer-nav-page="profile" href="${pageContext.request.contextPath}/index.jsp?page=profile">Perfil</a>
